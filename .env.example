# AgriLink Meta WhatsApp Cloud API Configuration
# Get these from https://developers.facebook.com -> Your WhatsApp App

# 1. Permanent System User Access Token from Meta
WHATSAPP_CLOUD_API_TOKEN=EAA...

# 2. Phone Number ID from Meta WhatsApp Dashboard
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# 3. Secret Webhook Verification Token (You choose this string, default is below)
WHATSAPP_VERIFY_TOKEN=agrilink_sfic_2026_secret
