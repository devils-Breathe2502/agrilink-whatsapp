# AgriLink WhatsApp Integration Environment Variables

# Twilio Credentials (Primary for Sandbox / SMS fallback - Ref R31)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Meta WhatsApp Cloud API (Alternative direct option)
WHATSAPP_CLOUD_API_TOKEN=EAAxxxxxxx...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_VERIFY_TOKEN=agrilink_sfic_2026_secret

# Supabase PostgreSQL Settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJh......

# AI / Speech-to-Text API (OpenAI Whisper or Bhashini)
AI_API_KEY=sk-xxxx...
